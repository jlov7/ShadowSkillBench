<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ShadowSkillBench evidence-bound report</title>
<style>
:root { color-scheme: light; font-family: ui-sans-serif, system-ui, sans-serif; color: #17212b; background: #f7f4ed; }
body { max-width: 1200px; margin: 0 auto; padding: 2rem; line-height: 1.5; }
header, section { margin-block: 2rem; }
h1, h2 { line-height: 1.15; }
.status { display: inline-block; border: 2px solid #17212b; padding: .25rem .55rem; font-weight: 700; }
table { width: 100%; border-collapse: collapse; margin-block: 1rem; background: #fffdf8; }
caption { text-align: left; font-weight: 700; margin-bottom: .4rem; }
th, td { border: 1px solid #697680; padding: .45rem; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
th { background: #e5ece8; }
code { background: #e9e5dc; padding: .12rem .25rem; overflow-wrap: anywhere; }
:focus-visible { outline: 3px solid #0d5a82; outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; } }
</style>
</head>
<body>
<header>
  <p class="status">$status</p>
  <h1>ShadowSkillBench evidence-bound report</h1>
  <p>$claim_ceiling</p>
</header>
<main>
  <section aria-labelledby="executive-summary"><h2 id="executive-summary">Executive summary</h2><p>$claim_ceiling</p></section>
  <section aria-labelledby="prior-art"><h2 id="prior-art">Prior art / claim</h2>$prior_art</section>
  <section aria-labelledby="protocol-integrity"><h2 id="protocol-integrity">Protocol integrity</h2>$protocol_integrity</section>
  <section aria-labelledby="figure-1"><h2 id="figure-1">Figure 1 — response curves</h2>$figure_1</section>
  <section aria-labelledby="figure-2"><h2 id="figure-2">Figure 2 — compliance and over-enforcement</h2>$figure_2</section>
  <section aria-labelledby="stage-a-marginal-effects"><h2 id="stage-a-marginal-effects">Stage A marginal effects</h2>$stage_a_marginal_effects</section>
  <section aria-labelledby="stage-b-estimands"><h2 id="stage-b-estimands">Stage B primary estimands</h2>$stage_b_estimands</section>
  <section aria-labelledby="domain-breakdown"><h2 id="domain-breakdown">Domain breakdown</h2>$domain_breakdown</section>
  <section aria-labelledby="cost"><h2 id="cost">Cost</h2>$cost</section>
  <section aria-labelledby="representative-traces"><h2 id="representative-traces">Representative traces</h2>$representative_traces</section>
  <section aria-labelledby="null-adverse"><h2 id="null-adverse">Null / adverse findings</h2>$null_adverse</section>
  <section aria-labelledby="limitations"><h2 id="limitations">Limitations</h2><ul>$limitations</ul></section>
  <section aria-labelledby="claims-ledger"><h2 id="claims-ledger">Claims ledger</h2>$claims_ledger</section>
  <section aria-labelledby="reproduce"><h2 id="reproduce">Reproduce command</h2><p><code>$reproduce_command</code></p></section>
</main>
</body>
</html>
